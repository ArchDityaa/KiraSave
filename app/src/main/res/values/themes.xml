<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KiraSave" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/kira_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:colorAccent">@color/kira_orange</item>
    </style>

    <style name="Theme.KiraSave.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kira_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Theme.KiraSave</item>
    </style>
</resources>
